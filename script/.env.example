# setup_key.py で作成する .env の書式例。ここに実際のキーを書かないでください。
GEMINI_API_KEY=
# OPENAI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
# 固定URLは uv run setup_share.py で初回設定します。
# SHARE_PROVIDER=ngrok
# NGROK_AUTHTOKEN=
# NGROK_URL=

# RenderのEnvironmentで設定（値をGitにコミットしない）。ローカルは未設定ならSQLite。
# JUDGE_MODE=gemini
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=
